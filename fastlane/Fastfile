fastlane_version "2.58.0"

default_platform :ios

platform :ios do
  before_all do

  end
  desc "Run the Swift package test suite"
  lane :test do
      Actions.sh("swift test")
  end

  desc "Release new version"
  lane :release do |options|
      target_version = options[:version]
      raise "The version is missed. Use `fastlane release version:{version_number}`.`" if target_version.nil?

      ensure_git_branch
      ensure_git_status_clean

      bump_swift_version_constant(target_version)

      test

      changelog = changelog_from_git_commits

      Action.sh("git add -A")
      Actions.sh("git commit -am \"Bumped to version #{target_version}\"")

      Actions.sh("git tag -a #{target_version} -m ''")

      push_to_git_remote
  end

  # The version source of truth is the `APlay.version` Swift constant; the
  # podspec is gone, so the constant is bumped here instead of
  # `version_bump_podspec`. The bump runs *before* the test lane on purpose:
  # `APlaySmokeTests` asserts `APlay.version` equals the release number, so the
  # suite only goes green when the constant and its assertion move together.
  def bump_swift_version_constant(target_version)
    path = "APlay/APlay.swift"
    contents = File.read(path)
    updated = contents.gsub(
      /(public static let version: String = ")[^"]*(")/,
      "\\1#{target_version}\\2"
    )
    UI.user_error!("Could not find the APlay.version constant in #{path}") if updated == contents
    File.write(path, updated)
  end

  after_all do |lane|

  end

  error do |lane, exception|

  end
end
